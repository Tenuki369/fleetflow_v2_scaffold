# ---------- App ----------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ---------- Database (Neon) ----------
# Pooled (PgBouncer) — used by app runtime
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.us-east-1.aws.neon.tech/fleetflow?sslmode=require&pgbouncer=true&connect_timeout=10"
# Direct connection — used by Prisma migrate, introspect
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.us-east-1.aws.neon.tech/fleetflow?sslmode=require"
# Neon API key (preview branch automation)
NEON_API_KEY=""
NEON_PROJECT_ID=""

# ---------- Auth (Clerk) ----------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/login"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/signup"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dispatch"

# ---------- Object Storage (Cloudflare R2 via S3 API) ----------
AWS_REGION="auto"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET="fleetflow-docs-dev"
# Optional — set for R2; omit for AWS S3 default
S3_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
S3_PUBLIC_URL="https://docs.fleetflow.app"

# ---------- Stripe ----------
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PRO=""

# ---------- Email (Resend) ----------
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="FleetFlow <noreply@fleetflow.app>"

# ---------- Sentry ----------
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG="fleetflow"
SENTRY_PROJECT="tms-v2"
SENTRY_AUTH_TOKEN=""

# ---------- PostHog ----------
NEXT_PUBLIC_POSTHOG_KEY="phc_..."
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# ---------- Inngest ----------
INNGEST_SIGNING_KEY=""
INNGEST_EVENT_KEY=""

# ---------- Upstash Redis (rate limit, cache) ----------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ---------- Webhooks (optional shared receiver) ----------
WEBHOOK_URL=""

# ---------- BetterStack ----------
BETTERSTACK_SOURCE_TOKEN=""
BETTERSTACK_HEARTBEAT_URL=""
