# ---------- App ----------
# Local: http://localhost:3000
# Vercel Preview/Staging: set this to the deployed preview URL for the branch
# Vercel Production: set this to the live domain
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ---------- Database (Neon / Postgres) ----------
# Pooled (PgBouncer) - used by app runtime
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.us-east-1.aws.neon.tech/fleetflow?sslmode=require&pgbouncer=true&connect_timeout=10"
# Direct connection - used by Prisma migrate and introspection
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.us-east-1.aws.neon.tech/fleetflow?sslmode=require"
# Optional: Neon automation only. Not read by the app today.
NEON_API_KEY=""
NEON_PROJECT_ID=""

# ---------- Auth (Clerk) ----------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/login"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/signup"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dispatch"

# ---------- Object Storage (Cloudflare R2 via S3 API) ----------
AWS_REGION="auto"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET="fleetflow-docs-dev"
# Optional - set for R2 or another S3-compatible endpoint
S3_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
S3_PUBLIC_URL="https://docs.fleetflow.app"

# ---------- Stripe ----------
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PRO=""

# ---------- Email (optional; not read by the app today) ----------
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="FleetFlow <noreply@fleetflow.app>"

# ---------- Sentry ----------
FLEETFLOW_ENABLE_SENTRY="false"
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG="fleetflow"
SENTRY_PROJECT="tms-v2"
SENTRY_AUTH_TOKEN=""

# ---------- PostHog (optional; not read by the app today) ----------
NEXT_PUBLIC_POSTHOG_KEY="phc_..."
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# ---------- Inngest (optional; not read by the app today) ----------
INNGEST_SIGNING_KEY=""
INNGEST_EVENT_KEY=""

# ---------- Upstash Redis (optional; not read by the app today) ----------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ---------- Webhooks (optional shared receiver) ----------
WEBHOOK_URL=""

# ---------- BetterStack (optional; not read by the app today) ----------
BETTERSTACK_SOURCE_TOKEN=""
BETTERSTACK_HEARTBEAT_URL=""
