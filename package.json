{
  "name": "fleetflow-tms",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "test:unit": "vitest run",
    "lint": "next lint",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "release:check": "npm run test:unit && npm run db:validate && npm run db:generate && npm exec tsc -- --noEmit && npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1048.0",
    "@aws-sdk/s3-request-presigner": "3.1048.0",
    "@clerk/nextjs": "7.3.5",
    "@hookform/resolvers": "3.9.0",
    "@prisma/client": "5.20.0",
    "next": "15.5.18",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.53.1",
    "stripe": "17.2.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "20.16.11",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.18",
    "postcss": "8.5.10",
    "prisma": "5.20.0",
    "tailwindcss": "3.4.13",
    "tsx": "4.22.0",
    "typescript": "5.6.3",
    "vitest": "^4.1.6"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "postcss": "8.5.10"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
